/* 双核链接脚本：IRAM/DRAM 基址由 --defsym 按核传入。
 *  kcore0 : __iram_base=0x00000000, __dram_base=0x10000000
 *  kcore1 : __iram_base=0x20000000, __dram_base=0x30000000
 *  Makefile 通过 -Wl,--defsym=__iram_base=... -Wl,--defsym=__dram_base=... 覆盖。
 */
MEMORY
{
IRAM(RWX)  : ORIGIN = __iram_base,  LENGTH = 0x40000
DRAM(RWX)  : ORIGIN = __dram_base,  LENGTH = 0xc0000
}
__kernel_stack = __dram_base + 0xbfff8 ;

ENTRY(__start)

SECTIONS {
    .text :
    {
        crt0.o (.text)
        *(.text*)
        . = ALIGN(0x10);
    } >IRAM
    .rodata :
    {
      *(.rodata*)
          . = ALIGN(0x4);
        __erodata = .;
    } > IRAM
    .data :
    {
      . = ALIGN(0x4);
      __data_start__ = .;
        *(.data*)
        *(.eh_frame*)
          . = ALIGN(0x4);
        __data_end__ = .;
    } >DRAM AT > IRAM
    .bss :
    {
      . = ALIGN(0x4);
      __bss_start__ = .;
        *(.bss)
         . = ALIGN(0x4);
        __bss_end__ = .;
          *.(COMMON)
    } >DRAM
}
